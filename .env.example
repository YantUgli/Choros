# --- database ---
# Lokal (postgres di host, socket/tcp):
CHOROS_DATABASE_URL=postgresql+asyncpg://choros:choros@localhost:5432/choros
# docker-compose: ganti host jadi `db`

# --- app auth (lapisan 1: login ke dashboard sendiri) ---
CHOROS_SECRET_KEY=ganti-dengan-string-acak-panjang
CHOROS_ADMIN_USERNAME=admin
# hash bcrypt; buat dengan: python -m scripts.hash_password 'passwordmu'
CHOROS_ADMIN_PASSWORD_HASH=

# --- runtime ---
CHOROS_DEFAULT_PROJECT_PATH=/home/kbuser/bryant_folder
# root untuk worktree/sandbox mode otonom
CHOROS_ISOLATION_ROOT=/home/kbuser/.choros/worktrees
# timeout satu attempt (detik)
CHOROS_RUN_TIMEOUT=1800

# --- API key provider (dipakai OpenAICompatAdapter; opencode pakai config-nya sendiri) ---
GROQ_API_KEY=
TOGETHER_API_KEY=
